# Copy this file to .env and fill in your lab credentials.
# .env is ignored by Git and must never be committed.

# Wazuh API user password (wazuh-wui)
WAZUH_API_PASSWORD=CHANGE_ME_WAZUH_PASSWORD

# Splunk admin password
SPLUNK_PASSWORD=CHANGE_ME_SPLUNK_PASSWORD

# TheHive application secret (use a long random value)
THEHIVE_SECRET=CHANGE_ME_THEHIVE_SECRET

# TheHive API key used by the Wazuh -> TheHive integration.
# Create an API key in TheHive after the first startup, then put it here.
THEHIVE_API_KEY=CHANGE_ME_THEHIVE_API_KEY
